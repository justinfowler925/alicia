VOICEMAKER_API_KEY=your_voicemaker_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
VIDYARD_API_TOKEN=your_vidyard_api_token_here
GITHUB_TOKEN=your_github_token_for_clearspeed_demos_sync
# Required on any public / Clearspeed-managed host. Same value as Nucleus
# DEMO_MAKER_ACCESS_SECRET. Leave unset only on Studio/tailnet.
# DEMO_MAKER_ACCESS_SECRET=generate_a_long_random_string
# Optional overrides — widget id chooses the Vidyard folder; Referer must stay
# on an allowlisted host (www.clearspeeddemos.com), never demo.clearspeed.com.
# VIDYARD_UPLOADER_WIDGET_ID=MpWxjM6h_gYSzlY13AicUQ
# VIDYARD_UPLOAD_REFERER=https://www.clearspeeddemos.com/vidyard-upload/
# VIDYARD_UPLOAD_CALLBACK_URL=https://www.clearspeeddemos.com/api/vidyard-upload
PUBLIC_SITE_URL=https://demo.clearspeed.com
# Container volume root (Fly/Render). Studio uses DEMO_MAKER_STATE instead.
# DATA_DIR=/data
PORT=4173
HOST=0.0.0.0
