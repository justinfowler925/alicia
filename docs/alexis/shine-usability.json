{
  "version": 1,
  "cite": "shadcn-broadcast",
  "objects": [
    {
      "id": "navigation",
      "selector": ".product-tabs",
      "referenceRole": "navigation",
      "purpose": "Choose Brutus, Alexis, or Atlas"
    },
    {
      "id": "presenter",
      "selector": "#alexis-frame",
      "referenceRole": "media frame",
      "purpose": "See Alexis during conversation"
    },
    {
      "id": "talk",
      "selector": "#mic",
      "referenceRole": "playback controls",
      "purpose": "Start a live conversation"
    },
    {
      "id": "feedback-disclosure",
      "selector": "#alexis-improve summary",
      "referenceRole": "viewing notes",
      "purpose": "Review a conversational reply"
    },
    {
      "id": "feedback-form",
      "selector": "#alexis-feedback",
      "referenceRole": "viewing notes",
      "purpose": "Capture a specific correction",
      "appearsIn": "feedback-empty"
    },
    {
      "id": "feedback-status",
      "selector": "#alexis-feedback-status",
      "referenceRole": "caption",
      "purpose": "Know whether feedback is saved",
      "appearsIn": "feedback-empty"
    },
    {
      "id": "message",
      "selector": "#say",
      "referenceRole": "transcript",
      "purpose": "Ask a typed question",
      "appearsIn": "feedback-empty"
    },
    {
      "id": "transcript",
      "selector": "#conversation",
      "referenceRole": "transcript",
      "purpose": "Read every conversational turn without expanding a panel"
    },
    {
      "id": "video-status",
      "selector": "#alexis-status",
      "referenceRole": "caption",
      "purpose": "Understand video connection and end state"
    },
    {
      "id": "alexis-look",
      "selector": "#look-alexis",
      "referenceRole": "media controls",
      "purpose": "Choose Alexis portrait"
    },
    {
      "id": "alicia-look",
      "selector": "#look-alicia",
      "referenceRole": "media controls",
      "purpose": "Choose Alicia portrait"
    },
    {
      "id": "portrait",
      "selector": "#alexis-portrait",
      "referenceRole": "media frame",
      "purpose": "See the whole selected portrait"
    }
  ],
  "flows": [
    {
      "id": "feedback-empty",
      "userJob": "Inspect feedback and find the text conversation input",
      "steps": [
        {
          "action": "click",
          "selector": "#alexis-improve summary"
        },
        {
          "action": "visible",
          "selector": "#alexis-feedback"
        },
        {
          "action": "text",
          "selector": "#alexis-feedback-status",
          "value": "An answered turn from the shared brain is needed first."
        },
        {
          "action": "click",
          "selector": "#say"
        },
        {
          "action": "focused",
          "selector": "#say"
        }
      ]
    },
    {
      "id": "visible-transcript",
      "userJob": "Read the conversation and type without expanding any section",
      "steps": [
        {
          "action": "visible",
          "selector": "#conversation"
        },
        {
          "action": "visible",
          "selector": "#say"
        },
        {
          "action": "click",
          "selector": "#say"
        },
        {
          "action": "focused",
          "selector": "#say"
        }
      ]
    },
    {
      "id": "portrait-selection",
      "userJob": "Switch portraits while keeping conversation visible",
      "steps": [
        {
          "action": "click",
          "selector": "#look-alicia"
        },
        {
          "action": "visible",
          "selector": "#alexis-portrait"
        },
        {
          "action": "click",
          "selector": "#look-alexis"
        },
        {
          "action": "visible",
          "selector": "#conversation"
        }
      ]
    }
  ]
}
