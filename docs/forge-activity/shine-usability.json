{
  "version": 1,
  "cite": "spectrum-ai-chat",
  "timeoutMs": 60000,
  "objects": [
    {
      "id": "toggle",
      "selector": "#forge-toggle",
      "referenceRole": "navigation",
      "purpose": "Switch between Brutus and Forge"
    },
    {
      "id": "panel",
      "selector": "#forge-panel",
      "referenceRole": "session context",
      "purpose": "Know which agent is answering"
    },
    {
      "id": "history",
      "selector": "#forge-threads",
      "referenceRole": "session context",
      "purpose": "Return to saved conversations"
    },
    {
      "id": "transcript",
      "selector": "#forge-transcript",
      "referenceRole": "transcript",
      "purpose": "Read the saved dialogue"
    },
    {
      "id": "message",
      "selector": "#forge-message",
      "referenceRole": "composer",
      "purpose": "Write a follow-up"
    },
    {
      "id": "send",
      "selector": "#forge-send",
      "referenceRole": "command",
      "purpose": "Send the message"
    },
    {
      "id": "status",
      "selector": "#forge-status",
      "referenceRole": "recovery",
      "purpose": "See actual execution status"
    },
    {
      "id": "new",
      "selector": "#forge-new",
      "referenceRole": "command",
      "purpose": "Start another conversation"
    },
    {
      "id": "attach",
      "selector": "#forge-attach",
      "referenceRole": "command",
      "purpose": "Choose local files to attach"
    },
    {
      "id": "activity",
      "selector": "#forge-activity",
      "referenceRole": "recovery",
      "purpose": "Know the turn count, elapsed time and freshness of actual Forge activity"
    },
    {
      "id": "turn-count",
      "selector": "#forge-turn-count",
      "referenceRole": "session context",
      "purpose": "Identify the current turn and number of active turns"
    },
    {
      "id": "phase",
      "selector": "#forge-phase",
      "referenceRole": "recovery",
      "purpose": "Read the actual activity phase or connection uncertainty"
    }
  ],
  "flows": [
    {
      "id": "activity",
      "userJob": "Read the saved turn count and terminal status; reset for a new conversation. Active/quiet/offline/recovery/Stop are exercised in scripts/verify-forge-activity.cjs.",
      "steps": [
        {
          "action": "select",
          "selector": "#forge-threads",
          "value": "dec22b99-66fa-44ef-9c01-f10db3011cae"
        },
        {
          "action": "text",
          "selector": "#forge-turn-count",
          "value": "Turn 1 \u00b7 0 active"
        },
        {
          "action": "text",
          "selector": "#forge-phase",
          "value": "Complete"
        },
        {
          "action": "click",
          "selector": "#forge-new"
        },
        {
          "action": "text",
          "selector": "#forge-turn-count",
          "value": "0 turns \u00b7 0 active"
        },
        {
          "action": "text",
          "selector": "#forge-phase",
          "value": "Ready"
        }
      ]
    }
  ]
}
