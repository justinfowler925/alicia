<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.clearspeed.alicia-zoom-summaries</string>
  <!-- Zoom AI Companion summaries -> Alicia Inbox, via POST /api/zoom/poll.
       Distinct from com.clearspeed.alicia-zoom-notes, which reads Salesforce
       Meeting_Notes__c and therefore only ever sees CLOUD-RECORDED meetings.
       Justin does not cloud-record, so that job has posted 0 for months while
       correctly scanning 600+ of other people's notes. This one reads the
       summaries API directly and covers his own meetings.

       ~/.alicia/app, NOT ~/Projects/alicia: the shared checkout is a branch
       other sessions switch, and jobs left pointing at it silently ran
       five-month-old code. See tests/test_launchd_plists.py. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/justinfowler/.alicia/app/scripts/zoom-poll.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/justinfowler/.alicia/app</string>
  <key>RunAtLoad</key>
  <true/>
  <!-- Hourly. Zoom writes the summary within minutes of a meeting ending, and
       the ledger makes a re-run over the same window nearly free. -->
  <key>StartInterval</key>
  <integer>3600</integer>
  <key>StandardOutPath</key>
  <string>/Users/justinfowler/.cursor/logs/alicia-zoom-summaries.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/justinfowler/.cursor/logs/alicia-zoom-summaries.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>ALICIA_URL</key>
    <string>http://127.0.0.1:8768</string>
    <!-- A week is plenty at hourly cadence, and keeps the cold-start walk short. -->
    <key>ZOOM_POLL_DAYS</key>
    <string>7</string>
    <!-- Items he owns, plus items that name him. -->
    <key>ZOOM_POLL_OWNERS</key>
    <string>justin</string>
  </dict>
</dict>
</plist>
